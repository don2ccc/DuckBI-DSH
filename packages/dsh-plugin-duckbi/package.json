{
  "name": "@duckbi/dsh-plugin-duckbi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DuckBI: point DeepSeek Harness at folders of .log / Excel files and query them with DuckDB through chat, with charts and Excel/PDF export.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "lib/index.js",
  "bin": {
    "duckbi-install": "install.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-plugin": "node install.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@napi-rs/canvas": "^1.0.11",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2"
  }
}
